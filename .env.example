# Copy this file to `.env` and fill in values for your own build.
# Expo loads `.env` automatically. Variables prefixed EXPO_PUBLIC_ are
# inlined into the JavaScript bundle at build time.
#
# Never commit `.env`. The Webflow client secret must stay on your token
# proxy — it is not an EXPO_PUBLIC_ value and must not ship in the app.

# Display name and URL scheme
EXPO_PUBLIC_APP_NAME=Mobileflow
EXPO_PUBLIC_SLUG=mobileflow
EXPO_PUBLIC_SCHEME=mobileflow

# Native identifiers. Use your own reverse-DNS IDs for store builds.
EXPO_PUBLIC_BUNDLE_ID=com.example.mobileflowrn
EXPO_PUBLIC_ANDROID_PACKAGE=com.example.mobileflowrn

# Apple Developer team ID (optional for simulator; required for device/store)
EXPO_PUBLIC_APPLE_TEAM_ID=

# EAS (optional; run `eas init` if you use EAS Build)
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_EAS_OWNER=

# Webflow OAuth. Create an app at https://developers.webflow.com
# Redirect URI must match the value registered on the app (HTTPS callback
# that 302s to `${EXPO_PUBLIC_SCHEME}://oauth/callback`, or the custom scheme).
EXPO_PUBLIC_WEBFLOW_CLIENT_ID=
EXPO_PUBLIC_OAUTH_REDIRECT_URI=mobileflow://oauth/callback

# HTTPS endpoint that exchanges the OAuth code using the client secret.
# Host the secret on this proxy only. Prefer a www host if your apex 308s.
EXPO_PUBLIC_TOKEN_PROXY_URL=
