{
  "name": "mobileflowrn",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "dependencies": {
    "@expo/metro-runtime": "58.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "58.0.0-preview.0",
    "expo-ai-kit": "0.17.0",
    "expo-asset": "58.0.0",
    "expo-blur": "58.0.0",
    "expo-build-properties": "58.0.0",
    "expo-constants": "58.0.0",
    "expo-crypto": "58.0.0",
    "expo-font": "58.0.0",
    "expo-glass-effect": "58.0.0",
    "expo-haptics": "58.0.0",
    "expo-image": "58.0.0",
    "expo-image-picker": "58.0.0",
    "expo-linear-gradient": "58.0.0",
    "expo-linking": "58.0.0",
    "expo-router": "58.0.0",
    "expo-secure-store": "58.0.0",
    "expo-splash-screen": "58.0.0",
    "expo-status-bar": "58.0.0",
    "expo-symbols": "58.0.0",
    "expo-system-ui": "58.0.0",
    "expo-web-browser": "58.0.0",
    "mobileflow-on-device-planner": "file:./modules/mobileflow-on-device-planner",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-worklets": "0.12.2",
    "react-native-view-shot": "5.1.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "@vitest/coverage-v8": "^3.2.7",
    "expo-doctor": "1.20.1",
    "react-doctor": "^0.9.13",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "expo": {
    "install": {
      "exclude": ["react-native"]
    }
  },
  "overrides": {
    "expo-modules-core": "58.0.0",
    "react-native-worklets": "0.12.2",
    "react-native-reanimated": "4.6.0",
    "postcss": "8.5.28",
    "uuid": "11.1.1",
    "nanoid": "3.3.18",
    "js-yaml": "4.3.2",
    "browserslist": "4.28.9",
    "@xmldom/xmldom": "0.8.15",
    "decode-uri-component": "0.5.0"
  },
  "scripts": {
    "audit": "node scripts/audit.mjs",
    "check:xcode": "node -e \"require('xcode'); console.log('xcode module loaded')\"",
    "check:uuid-xcode": "node -e \"require('xcode'); require('uuid'); console.log('xcode and uuid load successfully')\"",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "start": "expo start",
    "android": "expo run:android",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "ios": "expo run:ios",
    "ios:pods": "bash scripts/ios-pods.sh",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "npm run typecheck && npm test",
    "prebuild:android": "expo prebuild --platform android --no-install --clean",
    "prebuild:ios": "expo prebuild --platform ios --no-install --clean",
    "prebuild:check": "expo prebuild --platform android --no-install --clean",
    "prebuild:ios:check": "expo prebuild --platform ios --no-install --clean",
    "export:web": "expo export --platform web --output-dir dist-web",
    "smoke:maestro": "maestro test .maestro/smoke.yaml",
    "lint:react": "npx react-doctor@latest",
    "ci": "node scripts/verify.mjs",
    "icon:generate": "python3 scripts/generate-app-icon.py && python3 scripts/build-mobileflow-icon.py",
    "icon:build": "python3 scripts/build-mobileflow-icon.py"
  }
}
